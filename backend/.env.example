# Vidit backend environment variables
# Copy to backend/.env for local development. On a deployment, set these in the
# environment of your backend host.

# ── Database ──────────────────────────────────────────────────────────────
# Local default points at the docker-compose Postgres on :5432
DATABASE_URL=postgresql://vision:vision@localhost:5432/vision

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# The app refuses to boot in production if this stays at the default.
JWT_SECRET=changeme-in-production
JWT_ALGORITHM=HS256
# 7 days
JWT_EXPIRE_MINUTES=10080

# ── Media storage ─────────────────────────────────────────────────────────
# "local" writes to LOCAL_STORAGE_DIR for offline dev / CI.
# "s3" requires the AWS_* and S3_* settings below.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.local-storage

# Required when STORAGE_BACKEND=s3
# Inline trailing comments (after the `=`) are NOT stripped by python-dotenv
# and pollute string values — keep comments on their own line.
AWS_REGION=
S3_BUCKET=
# e.g. d1234abcd.cloudfront.net (no scheme, no path)
CLOUDFRONT_DOMAIN=
# Leave AWS_* unset locally; on a deployment they come from your host's
# environment or the boto3 credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Upload limits ─────────────────────────────────────────────────────────
# 10 MB
MAX_IMAGE_SIZE=10485760
# 95 MiB: a max-size video plus multipart overhead stays under Cloudflare's
# free-plan 100 MB request cap once `api` is proxied.
MAX_VIDEO_SIZE=99614720
# Per-event cap on inline proof images (the `proof_files` batch a submit
# carries). The body-size middleware sizes the request ceiling from it, so
# raising it raises what one submit may weigh.
MAX_PROOF_IMAGES_PER_EVENT=10
# Approval requests one analyst may send in a trailing 24 hours, resolved ones
# included.
APPROVAL_REQUEST_DAILY_CAP=20

# ── CORS (production only — comma-separated) ──────────────────────────────
# Leave unset locally; the dev defaults already allow http://localhost:3000.
# CORS_ORIGINS=https://vidit.example.com,https://staging.vidit.example.com
# A single regex OR'd with CORS_ORIGINS. Defaults to ^https?://localhost:\d+$
# so several frontends (worktrees, alternate ports, `next dev --experimental-https`)
# can hit one backend without bouncing it. On a non-local DATABASE_URL this
# shipped default is dropped automatically (a live localhost regex plus
# credentialed CORS would let any localhost page read authenticated responses);
# prod uses the CORS_ORIGINS allowlist. Set a non-localhost pattern for staging.
# CORS_ORIGIN_REGEX=^https?://localhost:\d+$

# ── Rate limiting ─────────────────────────────────────────────────────────
# Per-endpoint slowapi limits (e.g. 5/min on /login, 10/hr on /register) — no
# global floor. Useful in prod; annoying during local owner self-test when the
# same tester is iterating on register/sign-in. Set to false to silence them all.
# RATE_LIMIT_ENABLED=true

# ── Cookie auth ───────────────────────────────────────────────────────────
# Default (dev): SameSite=lax, Secure=false — works for localhost:3000 ↔ :8000.
# When your frontend host and your API host live on different registrable
# domains, the browser treats them as cross-site. Set:
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
# COOKIE_DOMAIN is normally left empty (host-only cookie); only set it if you
# need to share a session across subdomains of a single domain.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# COOKIE_DOMAIN=

# ── Error tracking (optional) ─────────────────────────────────────────────
# Set SENTRY_DSN to enable Sentry. Leave empty to skip — the SDK only
# initialises when DSN is non-empty, so unset = no overhead, no PII leak.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production    # or staging / preview
# SENTRY_TRACES_SAMPLE_RATE=0.0    # 0.0 disables performance tracing

# ── Logging ───────────────────────────────────────────────────────────────
# Level of the app's own loggers (app.*): DEBUG, INFO, WARNING, ERROR or
# CRITICAL, in any case. WARNING and above print on stderr, the rest on stdout.
# Other libraries log from WARNING; uvicorn's lines follow its --log-level.
# LOG_LEVEL=INFO

# ── Trusted proxy hops ────────────────────────────────────────────────────
# Number of trusted reverse proxies in front of the backend. Each one
# appends its observed connecting IP to X-Forwarded-For when forwarding,
# so we pick the entry at position -TRUSTED_PROXY_HOPS to land on the
# value the *first* trusted proxy saw. Default 1 matches one reverse proxy
# (your host's edge) in front of the backend. Set 2 when a second trusted
# reverse proxy sits in front of it, or the audit log IP reads as the
# immediate proxy, not the actual client.
#
# Important: never set this higher than the *actual* number of trusted
# proxies in front. When the XFF chain is shorter than N,
# _client_ip clamps to the left-most entry (better forensics
# than dropping the value entirely), but the left-most entry is what
# the original client wrote, which is attacker-controllable. An over-
# bumped hop count regresses the spoof-resistance the right-most-entry
# rule exists to provide.
# TRUSTED_PROXY_HOPS=1

# ── Client IP header ──────────────────────────────────────────────────────
# A proxy that overwrites X-Forwarded-For with its own peer, instead of
# appending, leaves no client IP there. Behind a CDN that peer changes per
# request, so every request gets a fresh rate-limit bucket. Name the header
# that proxy overwrites with the client IP on every request; it takes
# precedence over TRUSTED_PROXY_HOPS. Never name a header the proxy passes
# through unchanged: the client would pick its own bucket.
# CLIENT_IP_HEADER=X-Real-IP

# ── Transactional email ───────────────────────────────────────────────────
# `console` (default) just logs the email body — perfect for local dev so
# you don't burn Resend quota or chase DKIM. Switch to `resend` once the
# domain is verified in the Resend dashboard.
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# `From:` address. Must match a domain you've verified with Resend.
EMAIL_FROM=noreply@vidit.app
EMAIL_FROM_NAME=Vidit
# Public origin of the frontend, used to build links in emails. No trailing
# slash. Locally points at the Next dev server; on a deployment, set it to
# your frontend's public origin.
FRONTEND_URL=http://localhost:3000
# Password-reset token TTL (minutes). Default: 15. Tighter values are
# safer; loosen at your own risk. Registration-confirmation TTL is
# hard-coded (24h) in services/registration.py.
# PASSWORD_RESET_TOKEN_MINUTES=15
# Where a "new content report" notification goes, one message per report
# filed. Unset (the default) sends nothing: reports are still recorded and
# still show up in the admin queue.
# REPORT_NOTIFY_EMAIL=support@vidit.app
# Notification emails sent in any trailing 24 hours, in total and per
# recipient. They share the provider's daily quota (100 on the Resend free
# tier) with the auth emails, which are never counted. Defaults: 50 and 10.
# NOTIFICATION_EMAIL_DAILY_CAP=50
# NOTIFICATION_EMAIL_DAILY_CAP_PER_USER=10
# Notification emails one actor's actions queue in any trailing 24 hours.
# Past it, the notification still reaches the feed and push. Default: 10.
# NOTIFICATION_EMAIL_DAILY_CAP_PER_ACTOR=10
# Product update emails (major release announcements) sent in any trailing
# 24 hours, and the most one worker pass sends. The notification cap plus the
# product update cap must stay below EMAIL_PROVIDER_DAILY_QUOTA, or the app
# refuses to start; the remainder carries the auth emails. Both are at least 1.
# PRODUCT_UPDATE_EMAIL_DAILY_CAP=30
# PRODUCT_UPDATE_EMAIL_BATCH_SIZE=10
# EMAIL_PROVIDER_DAILY_QUOTA=100
# Public API base, the frontend's NEXT_PUBLIC_API_URL. The one-click
# List-Unsubscribe header of every notification and product update email posts
# to it. In prod set it on the API and the worker: with COOKIE_SECURE=true the
# app refuses to start on a localhost API_URL.
API_URL=http://localhost:8000/api/v1

# ── Web Push ──────────────────────────────────────────────────────────────
# Required with COOKIE_SECURE=true: the API refuses to start without both. Set
# them on the API and on the import worker. `make env` fills a development key
# and subject here when they are absent, and never replaces a value already
# set. Outside a deployment, both empty turns push notifications off. The
# private key is the base64url raw P-256 key; the public key browsers subscribe
# with derives from it. Never commit a real key. The subject is a contact the
# push services can reach: a mailto: or https: URL.
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@vidit.app

# ── Admin role bootstrap ──────────────────────────────────────────────────
# Comma-separated allowlist. Every login/register checks the email against
# this list and flips ``is_admin=true`` on a match. Empty (the default for
# local dev) means nobody auto-promotes. On a deployment, set it to your admin
# address.
# ADMIN_EMAILS=admin@vidit.app

# ── X bot (the "tag @ViditBot" on-ramp) ───────────────────────────────────
# All empty locally: the bot runner (scripts/run_bot.py) refuses to start
# without the read pair, and the paid X API has no local-dev mode anyway.
# Reading mentions: the X app's app-only bearer token + the bot account's
# numeric user id (both from the X developer console). Set together.
X_BOT_BEARER_TOKEN=
X_BOT_USER_ID=
# The bot account's handle (no @), stripped from stored proof text. Defaults
# to viditbot; override for a staging bot or after a rename.
X_BOT_HANDLE=viditbot
# Posting replies: OAuth 1.0a user context for the bot account. Set all
# four or none; without them the bot processes mentions but posts nothing.
X_API_CONSUMER_KEY=
X_API_CONSUMER_SECRET=
X_BOT_ACCESS_TOKEN=
X_BOT_ACCESS_TOKEN_SECRET=
# Set to true once the Account Activity webhook is registered and subscribed
# (scripts/manage_x_webhook.py). While false the hourly poll treats every
# mention as nominal; once true, a mention first seen by the poll raises a
# "webhook gap" warning (the webhook should have delivered it).
X_WEBHOOK_ENABLED=false
# Billed-reply ceilings, counted over the trailing hour, in total and per
# author. Past a ceiling the detection still lands and only the reply is
# skipped. Raise both for a traffic spike, then set them back.
BOT_MAX_REPLIES_PER_HOUR=40
BOT_MAX_REPLIES_PER_AUTHOR_PER_HOUR=10

