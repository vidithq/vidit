# Vision frontend environment variables
# Copy to frontend/.env.local for local development. Production values live in Vercel.

# Backend API base URL (must include the /api/v1 suffix).
# Local default talks to a uvicorn instance on :8000.
# Production: NEXT_PUBLIC_API_URL=https://<railway-domain>/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Hostname of the CDN this deployment serves media from (bare host, no scheme
# or path). It pins both `next/image` (next.config.mjs) and the proof
# renderer's image `src` check (lib/proof.tsx), mirroring the backend's own
# host pin. Unset, `next/image` falls back to the distribution named in
# docs/engineering.md and the proof renderer keeps the permissive dev shape:
# any https host, plus the local-storage prefix.
# NEXT_PUBLIC_MEDIA_HOST=d1234abcd.cloudfront.net

# Landing-page demo video: an embed URL or a direct .mp4/.webm/.ogg/.mov.
# Unset, the landing renders a static placeholder instead of a player. Set on
# the deploy workflow from a repo variable.
# NEXT_PUBLIC_DEMO_VIDEO_URL=https://<cdn>/landing/promo.mp4

# Version string the "Beta · v..." badge renders. Unset, next.config.mjs falls
# back to `git describe --tags --always --dirty`, then to "dev" when there is
# no git history. Set explicitly by the deploy workflow so the value is
# auditable in the run logs.
# NEXT_PUBLIC_BUILD_VERSION=<tag-or-sha>

# Sentry — optional, leave unset locally. When set, the SDK boots in
# sentry.{client,server,edge}.config.ts and `app/error.tsx` /
# `app/global-error.tsx` forward caught exceptions. All four vars stay empty
# during the bootstrap phase before the Sentry project is provisioned —
# withSentryConfig and Sentry.init() both no-op gracefully.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@oXXXXX.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Server / edge runtime — set on Vercel only, not in the client bundle:
# SENTRY_DSN, SENTRY_ENVIRONMENT, SENTRY_TRACES_SAMPLE_RATE
# Build-time (for source-map upload, set on Vercel + the deploy workflow):
# SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN
